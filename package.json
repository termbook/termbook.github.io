{
  "name": "termbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free attendance and score sheets for Nigerian secondary schools.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
