    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
